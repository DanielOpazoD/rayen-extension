{
  "manifest_version": 3,
  "name": "Rayen Atenciones - Hospital Hanga Roa",
  "version": "2.37.1",
  "description": "Agenda, ficha clínica, interconsultas y recetas del Dr. Opazo desde Eloisa/Rayen, con caché local y exportación.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://clinicohangaroa.eloisa.cl/*", "https://examenesusuarios.hsalvador.cl/*", "http://10.4.69.90/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rayen Atenciones",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
