{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "chrome"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "app.js"
  ]
}
